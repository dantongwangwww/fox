        <fieldset class="layui-elem-field">
          <legend>模型</legend>
          <div style="display: flex; justify-content: space-evenly; margin-bottom: 10px">
            <div class="layui-input-inline" style="width: 60px;">
              <input type="checkbox" name="frame" title="边框" lay-skin="primary" ${a.hasFrame?"checked":""}>
            </div>
            <div class="layui-input-inline" style="width: 60px;">
              <input type="checkbox" name="text" title="刻度" lay-skin="primary" ${a.hasText?"checked":""}>
            </div>
            <!-- <div class="layui-input-inline" style="width: 60px;">
              <input type="checkbox" name="line" title="网格" lay-skin="primary" ${a.hasLine?"checked":""}>
            </div> -->
            <div class="layui-input-inline" style="width: 60px;">
              <input type="checkbox" name="plane" title="面" lay-skin="primary" ${a.hasPlane?"checked":""}>
            </div>
          </div>
        </fieldset>
        <fieldset class="layui-elem-field">
          <legend>颜色</legend>
          <div style="margin-bottom: 10px">
            <div class="layui-inline">
              <label class="layui-form-label" style="width: 110px">线颜色</label>
              <div id="gridColor" style="margin-top: 5px;"></div>
            </div>
            <div class="layui-inline">
              <label class="layui-form-label" style="width: 110px">面颜色</label>
              <div id="planeColor" style="margin-top: 5px;"></div>
            </div>
            <div class="layui-inline"${n?"":'style="display: none"'}>
              <label class="layui-form-label" style="width: 110px">背景颜色</label>
              <div id="sceneColor" style="margin-top: 5px;"></div>
            </div>
          </div>
        </fieldset>
        <fieldset class="layui-elem-field">
          <legend>刻度</legend>
          <div class="layui-form-item"  style="margin-bottom: 10px">
            <div style="display: flex; justify-content: space-between; margin-bottom: 10px">
              <div class="layui-inline">
                <label class="layui-form-label" style="width: 110px">字体大小</label>
                <div class="layui-input-block" style="margin-right: 0; width: 90px">
                  <select name="fontSize">
                    <option value="12">12</option>
                    <option value="14">14</option>
                    <option value="16">16</option>
                    <option value="18">18</option>
                    <option value="24">24</option>
                  </select>
                </div>
              </div>
              ${n?`
              <div class="layui-input-inline" style="width: 150px;">
                <input type="checkbox" name="syncRange" title="同步主视图范围" lay-skin="primary" }>
              </div>`:""}
            </div>
          </div>
          <div class="layui-form-item" style="margin-bottom: 10px">
            <div class="layui-inline" style="margin-right: 0">
              <label class="layui-form-label" style="width: 110px">X：范围</label>
              <div class="layui-input-inline" style="width: 90px;">
                <input type="number" name="x_min" class="layui-input" required
                  autocomplete="off" max="${q.x_max}" step="any">
              </div>
              <div class="layui-form-mid">-</div>
              <div class="layui-input-inline" style="width: 90px;">
                <input type="number" name="x_max" class="layui-input" required
                  autocomplete="off" min="${q.x_min}" step="any">
              </div>
              <div class="layui-form-label">间距</div>
              <div class="layui-input-inline" style="width: 90px;">
                <input type="number" name="intervalX" class="layui-input" required lay-verify="required"
                  autocomplete="off" step="any">
              </div>
            </div>
          </div>
          <div class="layui-form-item"  style="margin-bottom: 10px">
            <div class="layui-inline" style="margin-right: 0">
              <label class="layui-form-label" style="width: 110px">Y：范围</label>
              <div class="layui-input-inline" style="width: 90px;">
                <input type="number" name="y_min" class="layui-input" required
                  autocomplete="off" max="${q.y_max}" step="any">
              </div>
              <div class="layui-form-mid">-</div>
              <div class="layui-input-inline" style="width: 90px;">
                <input type="number" name="y_max" class="layui-input" required 
                  autocomplete="off" min="${q.y_min}" step="any">
              </div>
              <div class="layui-form-label">间距</div>
              <div class="layui-input-inline" style="width: 90px;">
                <input type="number" name="intervalY" class="layui-input" required lay-verify="required"
                  autocomplete="off" step="any">
              </div>
            </div>
          </div>
          <div class="layui-form-item"  style="margin-bottom: 10px">
            <div class="layui-inline" style="margin-right: 0">
              <label class="layui-form-label" style="width: 110px">Z：范围</label>
              <div class="layui-input-inline" style="width: 90px;">
                <input type="number" name="z_min" class="layui-input" required 
                  autocomplete="off" max="${q.z_max}" step="any">
              </div>
              <div class="layui-form-mid">-</div>
              <div class="layui-input-inline" style="width: 90px;">
                <input type="number" name="z_max" class="layui-input" required
                  autocomplete="off" min="${q.z_min}" step="any">
              </div>
              <div class="layui-form-label">间距</div>
              <div class="layui-input-inline" style="width: 90px;">
                <input type="number" name="intervalZ" class="layui-input" required lay-verify="required"
                  autocomplete="off" step="any">
              </div>
            </div>
          </div>
        </fieldset>
        <fieldset class="layui-elem-field"${n?"":'style="display: none"'}>
          <legend>缩放</legend>
          <div class="layui-form-item"  style="margin-bottom: 10px">
            <div class="layui-inline" style="margin-right: 0">
              <label class="layui-form-label" style="width: 110px">Z：系数</label>
              <div class="layui-input-inline" style="width: 90px;">
                <input type="number" name="scaleZ" class="layui-input" required autocomplete="off" step="any">
              </div>
            </div>
          </div>
        </fieldseet>
    </form>
    <style>
      button[colorpicker-events="clear"] {
        display: none;
      }
      /* 去掉 input 数字微调按钮 */
      input::-webkit-outer-spin-button, input::-webkit-inner-spin-button {
        -webkit-appearance: none;
      }
      input[type="number"] {
        -moz-appearance: textfield;
      }
      select { display: none; }
    </style>
