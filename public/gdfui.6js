                  <div class="gdf-${l.mapCtrl.elemId}-EditWellPlatform-layer">
                    <div class="gdf-EditWellPlatform-layer-box">
                      <p style="width:80px;">编辑模式：</p>
                      <div>
                        <input type="radio" id="gdf-${l.mapCtrl.elemId}-EditWellPlatform-radio-1" class="radio" name="${l.mapCtrl.elemId}-editType" value="0" ><label for="gdf-${l.mapCtrl.elemId}-EditWellPlatform-radio-1">移动</label>
                        <input type="radio" id="gdf-${l.mapCtrl.elemId}-EditWellPlatform-radio-2" class="radio" name="${l.mapCtrl.elemId}-editType" value="1"><label for="gdf-${l.mapCtrl.elemId}-EditWellPlatform-radio-2">旋转</label>
                        <input type="radio" id="gdf-${l.mapCtrl.elemId}-EditWellPlatform-radio-3" class="radio" name="${l.mapCtrl.elemId}-editType" value="2"><label for="gdf-${l.mapCtrl.elemId}-EditWellPlatform-radio-3">设置长度</label>
                        <input type="radio" id="gdf-${l.mapCtrl.elemId}-EditWellPlatform-radio-7" class="radio" name="${l.mapCtrl.elemId}-editType" value="3"><label for="gdf-${l.mapCtrl.elemId}-EditWellPlatform-radio-7">测距</label>
                      </div>
                    </div>
                    <div class="gdf-EditWellPlatform-layer-box checkbox">
                      <input type="checkbox" id="gdf-${l.mapCtrl.elemId}-FrontDistance" style="height: 30px;">
                      <label for="gdf-${l.mapCtrl.elemId}-FrontDistance" style="width:55px;">靶前距</label>
                      <input type="number" step="100" min="0" id="gdf-${l.mapCtrl.elemId}-FrontDistance-text" >
                      <span>米</span>
                      <input type="checkbox" id="gdf-${l.mapCtrl.elemId}-HorizontalDistance" style="height: 30px;">
                      <label for="gdf-${l.mapCtrl.elemId}-HorizontalDistance" style="width:55px;">水平距</label>
                      <input type="number" step="100" min="0" id="gdf-${l.mapCtrl.elemId}-HorizontalDistance-text" >
                      <span style="margin-right:0px">米</span>
                    </div>
                    <div class="gdf-EditWellPlatform-layer-box">
                      <p style="width:80px;">编辑内容：</p>
                      <div>
                        <input type="radio" id="gdf-${l.mapCtrl.elemId}-EditWellPlatform-radio-8" class="radio" name="${l.mapCtrl.elemId}-editContent" value="3"><label for="gdf-${l.mapCtrl.elemId}-EditWellPlatform-radio-8">单井</label>
                        <input type="radio" id="gdf-${l.mapCtrl.elemId}-EditWellPlatform-radio-6" class="radio" name="${l.mapCtrl.elemId}-editContent" value="2"><label for="gdf-${l.mapCtrl.elemId}-EditWellPlatform-radio-6">单列</label>
                        <input type="radio" id="gdf-${l.mapCtrl.elemId}-EditWellPlatform-radio-4" class="radio" name="${l.mapCtrl.elemId}-editContent" value="0"><label for="gdf-${l.mapCtrl.elemId}-EditWellPlatform-radio-4">半排列</label>
                        <input type="radio" id="gdf-${l.mapCtrl.elemId}-EditWellPlatform-radio-5" class="radio" name="${l.mapCtrl.elemId}-editContent" value="1"><label for="gdf-${l.mapCtrl.elemId}-EditWellPlatform-radio-5">全部</label>
                      </div>
                    </div>
                    <div class="gdf-EditWellPlatform-layer-box">
                      <p style="width:80px;">旋转角度：</p>
                      <input type="number"  min="0" max="360" step="1" id="gdf-${l.mapCtrl.elemId}-angle-text" oninput="this.value = this.value.replace(/[^\\d]/g, '')">
                      <span style="margin-right:0px">度</span>
                      <button style="margin-right:0px" id="gdf-${l.mapCtrl.elemId}-angle-right" class="gdf-angle-btn">顺时针</button>
                      <button style="margin-right:0px" id="gdf-${l.mapCtrl.elemId}-angle-left" class="gdf-angle-btn">逆时针</button>
                      <div class="gdf-${l.mapCtrl.elemId}-RangeRing" style="width:57px;">测距环：</div>
                      <input type="number" title="半径" step="100" min="0" id="gdf-${l.mapCtrl.elemId}-RangeRing-text" >
                      <span style="margin-right:0px">米</span>
                    </div>
                  </div>
                  <style>
                    .gdf-${l.mapCtrl.elemId}-EditWellPlatform-layer {
                      font-size: 14px;
                      padding: 6px 10px;
                      height: 100%;
                    }
                    .gdf-${l.mapCtrl.elemId}-EditWellPlatform-layer input[type="checkbox"],input[type="radio"],label:hover {
                      cursor: pointer;
                    }
                    .gdf-${l.mapCtrl.elemId}-EditWellPlatform-layer input{
                      border: 1px solid #ccc;
                    }
                    .gdf-EditWellPlatform-layer-box div {
                      margin: 0 0 0 -30px;
                    }
                    .gdf-EditWellPlatform-layer-box .radio {
                      line-height: 30px;
                      margin: 0 5px 0 15px;
                    }
                    .gdf-EditWellPlatform-layer-box {
                      line-height: 30px;
                      display: flex;
                    }    
                    .gdf-EditWellPlatform-layer-box input[type="number"] {
                      text-align: center;
                      margin:3px 0;
                      height: 24px;
                      width: 80px;
                    }
                    .gdf-EditWellPlatform-layer-box .gdf-${l.mapCtrl.elemId}-RangeRing {
                      margin-left: 10px;
                    }  
                    .gdf-EditWellPlatform-layer-box #gdf-${l.mapCtrl.elemId}-RangeRing-text {
                      width: 54px;
                    }  
                    .gdf-EditWellPlatform-layer-box #gdf-${l.mapCtrl.elemId}-angle-text {
                      width: 42px;
                    }    
                    .gdf-EditWellPlatform-layer-box input[type="checkbox"] {
                      margin:0 3px;
                    }    
                    .gdf-EditWellPlatform-layer-box.checkbox {
                      margin-left: 30px;
                    }    
                    .gdf-EditWellPlatform-layer-box button {
                      width: 60px;
                      height: 24px;
                    } 
                    .gdf-EditWellPlatform-layer-box span {
                      padding: 0 3px;
                      line-height: 24px;
                      margin:3px 0;
                      height: 24px;
                      border: 1px solid #ccc;
                      border-left: none;
                      background-color: #f2f2f2;
                      margin-right:25px;
                    }    
                    .gdf-EditWellPlatform-layer-box button {
                      padding: 0 3px;
                      line-height: 24px;
                      margin:3px 0;
                      height: 24px;
                      border: 1px solid #ccc;
                      background-color: #f2f2f2;
                      margin-right:25px;
                    }  
                    .gdf-EditWellPlatform-layer-box button:hover {
                      transition: .3s;
                      background-color: #ddd;
                      cursor: pointer;
                    }  
                    .gdf-EditWellPlatform-layer-box button:active{
                      background-color: #aaa;
                    }
                    .layui-layer{
                      border: 1px solid rgba(0, 0, 0, .1);
                      box-shadow: 1px 1px 5px rgba(0, 0, 0, .2);
